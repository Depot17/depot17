---
import BaseLayout from '../components/BaseLayout.astro';
import ProjectsSlot from '../components/projects_slot.astro';
import Three from '../components/Three';

const title = "Depot";
---

<BaseLayout title={title}>
	
	<div id="landing" class="h-screen w-screen min-h-160
		flex flex-col md:gap-y-3 pb-6 pt-18 md:pt-0 md:grid grid-rows-3
		px-4 lg:px-10 2xl:px-20 lg:mt-0 lg:py-20 spotlight
		bg-no-repeat bg-[center_top_-4rem] ">
		
		<p class="z-10 w-fit mx-auto px-2 py-1 rounded-sm text-center font-medium bg-lblue text-xs sm:text-base md:hidden ">
			UNDER CONSTRUCTION, SIGN UPS OPEN SOON 
		</p>

		<div class="z-10 w-full min-h-fit md:hidden pt-2 sm:pt-6">
			<h1 class="title">Build<br>Change</h1>
		</div>
<div></div>
		<div class="-mx-4 lg:-mx-10 2xl:-mx-20 w-screen box-border px-10 2xl:px-20 grow flex items-center justify-center md:grid md:grid-cols-3 items-center">

			<h1 id="from-left" class="title -translate-x-100 opacity-0 z-[100] hidden md:inline-grid justify-self-start">Build</h1>
			
			<div class="w-screen lg:w-full max-w-120 h-30 flex items-center justify-center 
			
			 justify-self-center relative">
				<div class="dragme col-start-1 row-start-1 w-screen h-full  md:z-[20] flex justify-center items-center">
					<Three client:load />
				</div>
				<form action="" method="POST" name="email-form" id="email"
				class="opacity-0 absolute bg-beige hidden lg:inline-flex flex justify-between font-medium rounded-full z-[100]
				
				text-md text-dbrown pr-2 pl-4 py-2 min-h-10 max-h-18 w-110  xl:w-120 2xl:w-140 3xl:w-160
			
				text-center outline-3 outline-dbrown transition-all duration-200">

					<input type="email" id="email" name="email" placeholder="RSVP: youremail@gmail.com" 
					class="pl-3 outline-none border-none min-w-4 text-green bg-transparent w-full "> 

					<button type="submit" value="submit" 
					class="bg-red font-medium 
					rounded-full text-md text-beige text-center">
						
						<span onclick="this.classList.toggle('text-blue')" 
						class="bg-lred rounded-full block box-border 
						w-12 md:w-10 aspect-[1/1] border-3 border-lgreen
						flex items-center justify-center focus:border-black hover:border-green transition-all ease-in-out duration-400 hover:bg-orange">
							<p class="text-beige font-bold">--&gt</p>
						</span>

					</button>

				</form>

			</div>

			<h1 id="from-right" class="title opacity-0 translate-x-100 z-[100] hidden md:inline-grid justify-self-end">Change</h1>

		</div>
		<div class="h-fit mt-auto z-10">
			<a class="lg:hidden block bg-orange w-fit px-3 py-2 rounded-full whitespace-nowrap text-white text-lg font-medium">SIGN UP --&gt</a>
			<div class="w-full flex justify-between items-center self-end pt-4">		
				<h4 id="scramble" class="opacity-0 mr-auto text-dbrown text-left max-w-80">Find a problem in a local or global community, and work with them to engineer a solution. </h4>
				<!-- <svg class="hidden lg:inline-flex " width="332" height="187" viewBox="0 0 332 187" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M206.173 1.5H312C322.217 1.5 330.5 9.78273 330.5 20V167C330.5 177.217 322.217 185.5 312 185.5H20C9.78274 185.5 1.5 177.217 1.5 167V42.6689C1.50022 32.4519 9.78287 24.1689 20 24.1689H166.295C171.793 24.1688 177.082 22.0634 181.074 18.2842L193.456 6.56445C196.892 3.31259 201.442 1.50009 206.173 1.5Z" stroke="white" stroke-width="3"/>
				</svg> -->

			</div>
		</div>


			
	
	</div>
	<hr id="imgslide" class="opacity-0 pt-20">


	<section id="about" class="fixed-nav-trigger pb-8 h-auto lg:py-20 w-full">
		<h2 class="abc xl:max-w-190 lg:max-w-160 max-w-140 font-medium">
			Build real sustainable solutions, and change the world. <i class="text-lgreen font4" >Today.</i>
		</h2>

		<div class=" w-full flex flex-wrap gap-x-12 xl:gap-x-4 2xl:justify-between">
			<div class="">
				<div class="abd text-dbrown max-w-50">
					<p>Supporting high school and post-secondary students in tackling world issues through tech. </p>
				</div>
				<!-- <a href='/get_started' class="mt-4 -ml-2 flex justify-between rounded-full bg-white items-center py-2 px-2 w-fit gap-2 border-2 border-dbrown">
					<h4 class="pl-2">Get Started</h4>
						<div class="bg-orange h-10 w-10 rounded-full flex items-center justify-center group">
					<img src="/images/arrow.svg" class="w-full h-auto">

						</div>

				</a> -->
				
			</div>
			<div class="hidden imgs xl:-translate-x-400 ml-auto grayscale xl:block 
			w-full max-w-60  xl:max-w-70 2xl:max-w-90 lg:h-70 rounded-xl mt-auto  bg-[url('/images/daydream.webp')] bg-cover bg-center group/daydream">
				<p class="w-full h-full bg-yellow/20 hover:bg-yellow/70
					rounded-xl transition-all duration-500 ease-in-out flex justify-center items-center text-center p-6 text-dbrown/0 group-hover/daydream:text-dbrown/100">
					100+ Hackers at Daydream 
				</p>

			</div>


		<div class="imgs xl:translate-x-400 mask-[url(/images/polygon2.svg)] md:mask-[url(/images/polygon.svg)] mt-10 grayscale 
			grow-1 w-80 xl:max-w-180 md:max-w-full mask-no-repeat mask-cover 
			h-100 lg:h-120 rounded-xl overflow-visible relative bg-[url('/images/jpeg.webp')] bg-cover bg-center">
				<p class="w-full h-full bg-yellow/25 hover:bg-yellow/70
					transition-all duration-500 ease-in-out flex justify-center items-center text-center p-6 text-dbrown/0 hover:text-dbrown/100">
					80+ Girls and non-binary folk at JPEG
				</p>


				
			</div>
			<div class="z-[100] xl:hidden grayscale w-[60%]  max-w-70 h-50 md:h-70 
				bg-[url('/images/daydream.webp')] bg-cover bg-center rounded-2xl group/daydream ml-auto mr-5 -translate-y-30 border-1 border-beige">
					
				<p class="w-full h-full bg-yellow/25 hover:bg-yellow/70
					rounded-xl transition-all duration-500 ease-in-out flex justify-center items-center text-center p-6 text-dbrown/0 hover:text-dbrown/100">
					100+ Hackers at Daydream (Game Jam)
				</p>
				</div>	
	</section>

