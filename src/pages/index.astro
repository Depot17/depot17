</div>


	
	<section class="w-full pt-10 md:pt-20 pb-20">

		<div class="w-full md:px-8 my-4 pb-4 space-y-4 ">

			<div class="flex items-end justify-start gap-x-10">
				<div>
					<h2 class="text-dbrown md:whitespace-nowrap">Realityware</h2>

				</div>
				<a href='/projects' class="border-lgreen border-2 h-16 w-16 aspect-[1/1] rounded-full flex items-center justify-center group ">
					<img src="/images/arrow.svg" class="w-full h-auto rotate-135">

				</a>
			</div>
			<p class="">From January to March 2026, highschool students can build solutions to local or global issues. We fully fund every stage, from prototype to production, host monthly AMAs with industry leaders, and offer extra prizes for standout projects.</p>
			<a href=#landing class="mt-4 -ml-2 flex justify-between rounded-full bg-white items-center py-2 px-2 w-fit gap-2 border-2 border-dbrown">
					<h4 class="pl-2 font-medium">RSVP</h4>
						<div class="bg-orange h-8 w-8 rounded-full flex items-center justify-center group">
					<img src="/images/arrow.svg" class="w-full h-auto">

					</div>

			</a>
			<img src="/images/jpeg_footer.jpg" class="grayscale rounded-xl opacity-80 mt-10">
<!-- 		
		<ProjectsSlot /> -->

	</section>

	<div class="click fixed top-0 left-0 opacity-0 z-1000 pointer-events-none select-none bg-dbrown border-2 border-brown rounded-xl rounded-bl-none text-green font-semibold tracking-wide px-1 py-0.5">
        <p>click</p>
    </div>
	<div class="drag fixed top-0 left-0 opacity-0 z-1000 pointer-events-none select-none bg-dbrown border-2 border-brown 
